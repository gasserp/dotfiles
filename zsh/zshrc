# =============================================================================
# .zshrc — linked to ~/.zshrc by install.sh
# Plugin manager: zinit (bootstraps itself on first run).
# Aliases / functions (cdc, ccd, tfp, tfa, tfi, lg, ...) come from
# ~/.config/zsh/aliases.zsh, which install.sh links to zsh/aliases.zsh.
# =============================================================================

# Set the directory we want to store zinit and plugins
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# Download Zinit, if it's not there yet
if [ ! -d "$ZINIT_HOME" ]; then
   mkdir -p "$(dirname $ZINIT_HOME)"
   git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

# Source/Load zinit
source "${ZINIT_HOME}/zinit.zsh"

# Plugins
zinit light zsh-users/zsh-syntax-highlighting
zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-autosuggestions
zinit light Aloxaf/fzf-tab

# Steal some stuff we want from ohmyzsh
zinit snippet OMZP::git
zinit snippet OMZP::sudo
zinit snippet OMZP::azure
zinit snippet OMZP::kubectl
zinit snippet OMZP::kubectx

# Set up Prompt (theme symlinked by install.sh)
if [ -f "$HOME/.config/oh-my-posh/dotfiles.omp.json" ]; then
    eval "$(oh-my-posh init zsh --config "$HOME/.config/oh-my-posh/dotfiles.omp.json")"
else
    eval "$(oh-my-posh init zsh)"
fi

# Load completions
autoload -Uz compinit && compinit
zinit cdreplay -q

# History
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# Case insensitive completion
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
# No default menu, we use fzf for suggestions
zstyle ':completion:*' menu no
# Folder preview
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'ls --color $realpath'

# fzf shell integration
eval "$(fzf --zsh)"

# Dotfiles extras: FZF_DEFAULT_OPTS / fd preview, and shared aliases
# (cdc, ccd, tfp, tfa, tfi, lg, g, gs, ...).
[ -f "$HOME/.config/fzf/fzf.zsh" ]     && source "$HOME/.config/fzf/fzf.zsh"
[ -f "$HOME/.config/zsh/aliases.zsh" ] && source "$HOME/.config/zsh/aliases.zsh"

export PATH="$HOME/.local/bin:$PATH"

# --- Claude Code + local Ollama models ---
# NOTE: 'ccd' is your fzf code-dir jumper (~/.config/zsh/aliases.zsh) — left untouched.
# ccq/ccdev now route through the token-accounting router (:4315), not Ollama directly,
# so local token usage is logged to ~/code/localLLM/proxy/logs/. cc-local starts the
# router on demand. Still 100% local — the router sends ':'-tagged models to Ollama.
alias ccq="$HOME/code/localLLM/cc-local qwen3-coder:30b"
alias ccdev="$HOME/code/localLLM/cc-local devstral:24b"
alias cchybrid="$HOME/code/localLLM/cc-hybrid"
alias cchybrid-sonnet="$HOME/code/localLLM/cc-hybrid claude-sonnet-5"
alias cchybrid-opus="$HOME/code/localLLM/cc-hybrid claude-opus-4-8"
alias cchybrid-fable="$HOME/code/localLLM/cc-hybrid claude-fable-5"
